# Copy to .env and adjust as needed:  cp .env.example .env
#
# Compose reads this file automatically for ${...} interpolation, and the
# Makefile includes it for its own variables.

# --- WordPress -------------------------------------------------------------
WP_PORT=8080
WP_SITE_URL=http://localhost:8080
WP_TITLE=Tainacan Dev
WP_ADMIN_USER=tainacan
WP_ADMIN_PASSWORD=tainacan
WP_ADMIN_EMAIL=tainacan@local.test
WP_LOCALE=en_US
WP_DEBUG=1

# --- Database --------------------------------------------------------------
DB_NAME=tainacan
DB_USER=tainacan
DB_PASSWORD=tainacan
DB_ROOT_PASSWORD=tainacan
DB_PORT=3306
DB_PREFIX=wp_

# --- Tainacan source -------------------------------------------------------
# Relative to the repository root, or an absolute path to an external clone.
# Only <path>/src is exposed to WordPress, read-only.
TAINACAN_PLUGIN_PATH=./tainacan

# --- Optional services -----------------------------------------------------
ES_PORT=9200
